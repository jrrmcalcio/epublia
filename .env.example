# --- Required ---------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
# To stay 100% free, create it in a Google Cloud project WITHOUT a billing account
# (AI Studio -> "Usage & Billing" must say "Free tier").
GEMINI_API_TOKEN=your-gemini-api-key-here

# Target language: ISO code (ES, FR, PT, pt-br, DE, IT...) or a language name.
TARGET_LANGUAGE=ES

# --- Model & quotas ---------------------------------------------------------
# Free-tier Flash model. Run `epublia --check` to list the models your key can use.
GEMINI_MODEL=gemini-3.8-flash
# Requests per minute (client-side throttle). Keep it at or below your free-tier RPM.
GEMINI_RPM=10
# Optional local requests-per-day cap (0 = no local cap; the server quota still applies).
GEMINI_RPD=0
# Max characters of source text per request (bigger = fewer requests, used against RPD).
MAX_CHARS_PER_REQUEST=24000
GEMINI_TEMPERATURE=0.3
# minimal | low | medium | high  (empty = model default). "low" is fast and good for translation.
GEMINI_THINKING_LEVEL=low

# --- Optional ---------------------------------------------------------------
# Remove PDF-conversion artefacts (running headers, page numbers, broken lines...) before translating.
CLEANUP=true
# Text file with fixed renderings, one per line, e.g. "Protoss = Protoss"
# GLOSSARY_FILE=glossary.txt
# Auto-build work/<book>/<lang>/glossary.txt with the model before translating (1-2 requests per book).
# AUTO_GLOSSARY=true
# Characters of the previous translated passage sent as context with each request (0 = off).
# CONTEXT_CHARS=1500
# Paragraphs longer than this are sent in sentence-aligned parts (limits what a blocked reply loses).
# SEGMENT_SPLIT_CHARS=6000
# Share names across the books of a series (work/series/<name>/<lang>/glossary.txt).
# Default: the book's series metadata (Calibre / EPUB 3), if any. "none" disables it.
# SERIES=StarCraft

# --- Backup model (optional) -------------------------------------------------
# Any OpenAI-compatible API, used only for passages Gemini refuses to translate.
# OpenRouter: FALLBACK_BASE_URL=https://openrouter.ai/api/v1   (free models end in ":free")
# Groq:       FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek:   FALLBACK_BASE_URL=https://api.deepseek.com        (paid, very cheap)
# Mistral:    FALLBACK_BASE_URL=https://api.mistral.ai/v1
# Ollama:     FALLBACK_BASE_URL=http://localhost:11434/v1       (local, no key)
# FALLBACK_BASE_URL=
# FALLBACK_API_KEY=
# Comma-separated list, tried in order (a busy model is skipped), e.g.
# google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,openrouter/free
# FALLBACK_MODEL=
# FALLBACK_RPM=10
# FALLBACK_RPD=0

# --- Validation (optional) ---------------------------------------------------
# W3C EPUBCheck jar (needs Java). Empty = auto-detect tools/epubcheck*/epubcheck.jar
# (install it with `epublia --install-epubcheck`); "off" disables it.
# EPUBCHECK_JAR=
# Repair validity errors the source EPUB already had (markup only, same rendering).
# REPAIR=true

# --- Folders -----------------------------------------------------------------
# Relative paths are resolved against EPUBLIA_HOME (default: the current folder, or the
# source checkout when running from one).
# INPUT_DIR=books-input
# OUTPUT_DIR=books-outputs
# WORK_DIR=work
