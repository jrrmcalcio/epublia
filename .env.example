# --- Required ---------------------------------------------------------------
# Gemini API key from https://aistudio.google.com/apikey
# To stay 100% free, create it in a Google Cloud project WITHOUT a billing account
# (AI Studio -> "Usage & Billing" must say "Free tier").
GEMINI_API_TOKEN=your-gemini-api-key-here

# Target language: ISO code (ES, FR, PT, pt-br, DE, IT...) or a language name.
TARGET_LANGUAGE=ES

# --- Model & quotas ---------------------------------------------------------
# Free-tier Flash model. Run `epublia --check` to list the models your key can use.
GEMINI_MODEL=gemini-3.8-flash
# Requests per minute (client-side throttle). Keep it at or below your free-tier RPM.
GEMINI_RPM=10
# Optional local requests-per-day cap (0 = no local cap; the server quota still applies).
GEMINI_RPD=0
# Max characters of source text per request (bigger = fewer requests, used against RPD).
MAX_CHARS_PER_REQUEST=24000
GEMINI_TEMPERATURE=0.3
# minimal | low | medium | high  (empty = model default). "low" is fast and good for translation.
GEMINI_THINKING_LEVEL=low

# --- Optional ---------------------------------------------------------------
# Remove PDF-conversion artefacts (running headers, page numbers, broken lines...) before translating.
CLEANUP=true
# Text file with fixed renderings, one per line, e.g. "Protoss = Protoss"
# GLOSSARY_FILE=glossary.txt
# INPUT_DIR=books-input
# OUTPUT_DIR=books-outputs
# WORK_DIR=work
